{
  "manifest_version": 3,
  "name": "BOSS直聘 自动投递助手",
  "version": "0.1.0",
  "description": "按你的条件筛选 BOSS 直聘岗位并自动投递。纯本地运行，默认试运行，带随机延迟与每日上限。",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "cookies", "clipboardWrite"],
  "host_permissions": ["https://*.zhipin.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "BOSS 自动投递助手",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhipin.com/web/geek/*",
        "https://*.zhipin.com/job_detail/*"
      ],
      "js": [
        "src/shared/defaults.js",
        "src/content/filters.js",
        "src/content/panel.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
